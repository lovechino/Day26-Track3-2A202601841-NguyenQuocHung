# Weather MCP Server Environment Variables
# Copy to .env and fill in your values

# Required: WeatherAPI.com API Key (free at https://www.weatherapi.com/)
WEATHERAPI_KEY=your_weatherapi_key_here

# Optional: Bearer token for MCP authentication (default: dev-token-abc123)
MCP_AUTH_TOKEN=dev-token-abc123

# Optional: Server port (default: 8085, Cloud Run will override)
PORT=8085